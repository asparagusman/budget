{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    // Sources are plain JS with types in JSDoc. `checkJs` is what keeps
    // `pnpm typecheck` meaningful — without it this config would pass while
    // checking nothing at all.
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    // Guards the largest-remainder division in engine/money.js and the
    // calendar math — the places a silent off-by-one stops cents reconciling.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  }
}
