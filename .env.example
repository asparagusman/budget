POSTGRES_USER=budget
POSTGRES_PASSWORD=            # generate; never commit a real value
POSTGRES_DB=budget
DATABASE_URL=postgres://budget:${POSTGRES_PASSWORD}@db:5432/budget
PORT=3001
SESSION_SECRET=               # generate 32+ bytes
VITE_API_URL=http://localhost:3001
PUBLIC_ORIGIN=http://localhost:5173   # phase 03 needs this for WebAuthn RP ID

# Optional. Stamped into the API image and reported by GET /health so you can
# tell which build is running. Set it to a git short SHA or a date on deploy;
# defaults to "dev".
APP_VERSION=dev
