# Comments live on their own lines. Compose reads `KEY=   # note` as the
# value "# note", so a password left blank would silently become that text.
POSTGRES_USER=budget
# Generate one (infra/README.md step 3); never commit a real value.
POSTGRES_PASSWORD=
POSTGRES_DB=budget
DATABASE_URL=postgres://budget:${POSTGRES_PASSWORD}@db:5432/budget
PORT=3001
# Generate one, 32+ characters (infra/README.md step 3).
SESSION_SECRET=
VITE_API_URL=http://localhost:3001
# The address the household types. Deployed: http://budget.local exactly.
PUBLIC_ORIGIN=http://localhost:5173

# The household's timezone. The api's "today" is local time, and containers
# are UTC unless told otherwise — which makes today still yesterday until
# 10-11am in Australia. Compose falls back to Australia/Sydney if this is unset.
TZ=Australia/Sydney

# Optional. Stamped into the API image and reported by GET /health so you can
# tell which build is running; defaults to "dev". On the deployed host, leave
# it here and stamp each deploy on the command line instead —
# `APP_VERSION=$(git rev-parse --short HEAD) docker compose …` (infra/README.md)
# — since a value written here goes stale on the next pull.
APP_VERSION=dev

# Optional. Where the app writes its backups (Admin > Backups). Compose mounts
# infra/backups/ at /backups inside the api container and sets this itself, so
# it matters only for `pnpm dev`, which writes to infra/backups/ by default.
# BACKUP_DIR=
