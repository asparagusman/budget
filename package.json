{
  "name": "budget",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.3.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm -F @budget/api dev\" \"pnpm -F @budget/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm -F @budget/schema migrate",
    "db:generate": "pnpm -F @budget/schema generate",
    "db:seed": "pnpm -F @budget/schema seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
