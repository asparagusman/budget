    "@hono/zod-validator": "^0.9.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "vitest": "^3.2.7"
  }
