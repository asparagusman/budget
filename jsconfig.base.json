{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    // jsconfig implies allowJs. `checkJs` is what keeps `pnpm typecheck`
    // meaningful — without it this config would pass while checking nothing.
    "checkJs": true,
    // NOTE: setting this here does nothing — TypeScript forces the
    // jsconfig-name default of 2 over inherited values, so each package
    // repeats it locally. Left documented here so the next person doesn't
    // "tidy" the duplicates away. See any package's jsconfig.json.

    "strict": true,
    // Guards the largest-remainder division in engine/money.js and the
    // calendar math — the places a silent off-by-one stops cents reconciling.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  }
}
